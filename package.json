{
  "name": "tibr-perfumes",
  "version": "1.0.0",
  "description": "تبر للعطور - عطور مصرية معاصرة تجمع تراث الماضي وفخامة الحاضر.",
  "main": "server/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node server/index.js",
    "start": "node server/index.js",
    "client:dev": "cd client && npm run dev",
    "client:build": "cd client && npm run build",
    "client:install": "cd client && npm install",
    "build": "npm run client:build",
    "postinstall": "npm run client:install",
    "dev:all": "concurrently \"npm run dev\" \"npm run client:dev\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.53.0",
    "compression": "^1.8.1",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "multer": "^2.1.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "keywords": [
    "perfume",
    "landing-page",
    "gsap",
    "luxury"
  ],
  "author": "TIBR",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.3"
  },
  "allowScripts": {
    "ssh2@1.17.0": true
  }
}
